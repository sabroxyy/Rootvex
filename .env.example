# Copy to .env and fill in. Never commit .env.

# Model server (Ollama's OpenAI-compatible endpoint by default).
NETWARDEN_LLM__BASE_URL=http://localhost:11434/v1
NETWARDEN_LLM__MODEL=granite4:3b
# Ollama ignores the key, but the client needs a value.
NETWARDEN_LLM__API_KEY=ollama

# Lab-only device credentials, referenced by name from inventory.local.yaml.
LAB_DEVICE_PASSWORD=change-me
# Shared key for the R2 <-> BR1 IPsec tunnel (lab only).
LAB_VPN_PSK=change-me-too

# GNS3 lab build (lab/build_gns3_lab.py).
# Router platform: c7200 (Dynamips, image in ~/GNS3/images/IOS) or iosv (QEMU, ~/GNS3/images/QEMU).
LAB_ROUTER_PLATFORM=c7200
LAB_C7200_IMAGE=c7200-advipservicesk9-mz.152-4.S5.image
# Filled in automatically by --start; set it here to skip the Idle-PC calculation.
# LAB_C7200_IDLEPC=
# LAB_IOSV_IMAGE=vios-adventerprisek9-m.spa.159-3.m9.qcow2
# Only needed if your GNS3 server is remote or uses a custom login;
# by default the script reads the GUI's ~/.config/GNS3/*/gns3_server.conf.
# GNS3_SERVER=http://127.0.0.1:3080
# GNS3_USER=admin
# GNS3_PASSWORD=
