# Copy to .env and fill in. Never commit .env.

# Model server (Ollama's OpenAI-compatible endpoint by default).
NETWARDEN_LLM__BASE_URL=http://localhost:11434/v1
NETWARDEN_LLM__MODEL=granite4:3b
# Ollama ignores the key, but the client needs a value.
NETWARDEN_LLM__API_KEY=ollama

# Lab-only device credentials, referenced by name from inventory.local.yaml.
LAB_DEVICE_PASSWORD=change-me
